{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install dependencies",
      "type": "shell",
      "command": "npm install --no-fund --no-audit",
      "problemMatcher": [],
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "Start app",
      "type": "npm",
      "script": "start",
      "problemMatcher": []
    },
    {
      "label": "Build portable EXE",
      "type": "npm",
      "script": "dist",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Build installer EXE",
      "type": "npm",
      "script": "dist:installer",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Publish GitHub release",
      "detail": "Builds both exes and replaces the files on the GitHub release, so the app's update check finds them",
      "type": "npm",
      "script": "release",
      "problemMatcher": []
    },
    {
      "label": "Regenerate app icon",
      "type": "npm",
      "script": "icon",
      "problemMatcher": []
    }
  ]
}
