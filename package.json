{
  "name": "discord-server-builder",
  "productName": "Discord Server Builder",
  "version": "1.0.0",
  "description": "Pixelplayz-themed desktop app to manage Discord bots, moderate servers and build server layouts from templates.",
  "main": "src/main/main.js",
  "author": "Pixelplayz2215",
  "license": "MIT",
  "private": true,
  "updateRepo": "Pixelplayz2215/discord-server-builder",
  "modPortalUrl": "",
  "modViewPortalUrl": "https://discord-mod-portal.onrender.com",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icon": "node scripts/make-icon.js",
    "fonts": "node scripts/copy-fonts.js",
    "pack": "electron-builder --win dir",
    "dist": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis",
    "dist:mod": "node scripts/build-mod-view.js",
    "release": "node scripts/release.js",
    "portal": "node server/index.js",
    "test:portal": "node --test server/portal.test.js"
  },
  "dependencies": {
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@fontsource/poppins": "5.2.6",
    "@fontsource/silkscreen": "5.2.6",
    "electron": "44.10.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "org.pixelplayz.discordserverbuilder",
    "productName": "Discord Server Builder",
    "copyright": "Pixelplayz2215",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "DiscordServerBuilder-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "DiscordServerBuilder-${version}-setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
